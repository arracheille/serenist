{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.7.2" }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "buildCommand": "npm run build",
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_URL": "https://serenist.vercel.app",
        "APP_KEY": "base64:U3bbou/Z423E6Q+DGCOp6mO0jnt0m9KQ175Jm/ll+zQ=",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "mysql",
        "DB_DATABASE": "serenist"
    }
}
